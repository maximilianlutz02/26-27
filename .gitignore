# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron
.env

# Hinweis: docs/ wird bewusst NICHT ignoriert.
# Die Folien werden lokal mit `quarto render` gebaut und der fertige
# Ordner docs/ committet, damit Netlify ihn direkt ausliefern kann.

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Quarto-Zwischendateien
/.quarto/
slides/*_cache/
*.rmarkdown

# Hinweis: slides/*.html und die zugehörigen slides/*_files/ werden BEWUSST
# versioniert. Es sind die vorgerenderten Lehrvideo-Foliensätze (xaringan),
# die von slides.html eingebettet und von Netlify ausgeliefert werden.
# Die neue interaktive Vorlesung (Quarto) rendert dagegen nach docs/.

# R
.Rproj.user/
.Rhistory
.RData

# Entpackte Excel-Datei aus dem Arbeitslose-ZIP (wird im Setup wieder gelöscht)
slides/*.xlsx

**/*.quarto_ipynb

# Rohdaten der Case-Study (~131 MB: .rds/.xlsx/.zip). Reine Quell-/Reproduktions-
# daten – die ausgelieferten case-study/*.html sind self-contained und brauchen
# sie NICHT. Zu groß für Git/Netlify; bei Bedarf separat (Git LFS/Cloud) ablegen.
case-study/data/*
!case-study/data/Readme.md
.positai
